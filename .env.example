# Variables de Entorno Opcionales — MercaDónde

# 1. Base de Datos NoSQL (MongoDB)
# Si se omite, la aplicación utiliza automáticamente el almacén NoSQL local JSON (.data/mercadonde-db.json)
MONGODB_URI=

# 2. Notificaciones por Email (Resend)
# Si se omite, el endpoint /api/alerts/dispatch opera en modo simulado sin errores
RESEND_API_KEY=
RESEND_FROM_EMAIL="MercaDónde Alertas <onboarding@resend.dev>"
